rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isMessMember(messId) {
      return isSignedIn() && exists(/databases/$(database)/documents/messes/$(messId)/members/$(request.auth.uid));
    }
    function getMemberRole(messId) {
      return get(/databases/$(database)/documents/messes/$(messId)/members/$(request.auth.uid)).data.role;
    }
    function getMessManager(messId) {
      return get(/databases/$(database)/documents/messes/$(messId)).data.currentManagerId;
    }
    function isAdmin(messId) {
      return isMessMember(messId) && getMemberRole(messId) == 'admin';
    }
    function isManager(messId) {
      return isMessMember(messId) && (getMessManager(messId) == request.auth.uid || getMemberRole(messId) == 'manager');
    }

    // User profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    // Messes
    match /messes/{messId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin(messId);

      // Members sub-collection
      match /members/{memberId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if isAdmin(messId) || isOwner(memberId);
      }

      // Meal entries sub-collection
      match /mealEntries/{entryId} {
        allow read: if isMessMember(messId);
        allow create, update: if isManager(messId) || (isMessMember(messId) && request.resource.data.memberId == request.auth.uid);
        allow delete: if isManager(messId);
      }

      // Grocery entries sub-collection
      match /groceryEntries/{entryId} {
        allow read: if isMessMember(messId);
        allow create: if isMessMember(messId);
        allow update: if isManager(messId);
        allow delete: if isManager(messId) || (isMessMember(messId) && resource.data.purchasedBy == request.auth.uid);
      }

      // Deposit entries sub-collection
      match /deposits/{depositId} {
        allow read: if isMessMember(messId);
        allow create: if isMessMember(messId);
        allow update, delete: if isManager(messId);
      }

      // Settlement sub-collection
      match /settlements/{settlementId} {
        allow read: if isMessMember(messId);
        allow write: if isManager(messId) || isAdmin(messId);
      }

      // Invites sub-collection
      match /invites/{inviteId} {
        allow read, create: if isMessMember(messId);
        allow update, delete: if isAdmin(messId);
      }
    }
  }
}
