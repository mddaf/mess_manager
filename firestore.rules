rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // User profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write, update: if isSignedIn();
    }

    // Messes
    match /messes/{messId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();

      // Members sub-collection
      match /members/{memberId} {
        allow read, create, update, delete: if isSignedIn();
      }

      // Meal entries sub-collection
      match /mealEntries/{entryId} {
        allow read, create, update, delete: if isSignedIn();
      }

      // Grocery entries sub-collection
      match /groceryEntries/{entryId} {
        allow read, create, update, delete: if isSignedIn();
      }

      // Deposit entries sub-collection
      match /deposits/{depositId} {
        allow read, create, update, delete: if isSignedIn();
      }

      // Settlement sub-collection
      match /settlements/{settlementId} {
        allow read, write, delete: if isSignedIn();
      }

      // Invites sub-collection
      match /invites/{inviteId} {
        allow read, create, update, delete: if isSignedIn();
      }
    }
  }
}
