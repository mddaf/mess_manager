{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "meal-manager-844f5",
          "appId": "1:842933413489:android:65e90921f4879675fc1dd0",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "meal-manager-844f5",
          "configurations": {
            "android": "1:842933413489:android:65e90921f4879675fc1dd0",
            "ios": "1:842933413489:ios:26c1329003386999fc1dd0",
            "web": "1:842933413489:web:e156d51865070a60fc1dd0"
          }
        }
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": []
    }
  ],
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/__/auth/action",
        "destination": "/action",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
